<?xml version="1.0" encoding="utf-8"?>
<!-- Files other apps may be handed: exports for the share sheet (src/mobile/index.ts
     writes them to cache/exports), and photos the file chooser's camera option takes
     (Capacitor's BridgeWebChromeClient saves them under Pictures in app storage). -->
<paths xmlns:android="http://schemas.android.com/apk/res/android">
    <cache-path name="exports" path="exports/" />
    <external-files-path name="camera" path="Pictures/" />
</paths>
