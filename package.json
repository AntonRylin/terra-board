{
  "name": "terra-board",
  "productName": "Terra Board",
  "version": "0.1.38",
  "description": "A private, local visual workspace",
  "author": "Terra Board",
  "license": "MIT",
  "type": "module",
  "main": "electron/main.cjs",
  "terraCloud": {
    "url": "https://iolkrvqpwbiwfahfcjcq.supabase.co",
    "key": "sb_publishable_rblk19HUEG-TKNpssPf5bQ_0RrXAplo"
  },
  "scripts": {
    "dev": "node scripts/prepare-documents.mjs && node scripts/prepare-background-model.mjs && node scripts/prepare-yt-dlp.mjs && node scripts/build-extensions.mjs --allow-missing && node scripts/dev.mjs",
    "preview": "node scripts/prepare-documents.mjs && vite --host 127.0.0.1",
    "build": "node scripts/prepare-documents.mjs && node scripts/prepare-background-model.mjs && node scripts/prepare-yt-dlp.mjs && tsc --noEmit && vite build",
    "start": "electron .",
    "test": "node scripts/prepare-background-model.mjs && node --test tests/*.test.mjs",
    "prepackage": "node scripts/check-package-idle.mjs",
    "package": "npm run build && node scripts/prepare-vc-runtime.mjs && node scripts/build-extensions.mjs && electron-builder --win dir",
    "installer": "npm run build && node scripts/prepare-vc-runtime.mjs && node scripts/build-extensions.mjs && electron-builder --config electron-builder.installer.cjs --win nsis --x64 --publish never",
    "installer:linux": "npm run build && node scripts/build-extensions.mjs && electron-builder --config electron-builder.linux.cjs --linux --x64 --publish never",
    "build:android": "node scripts/prepare-documents.mjs && tsc --noEmit && vite build --mode android --outDir dist-android && cap sync android",
    "android:apk": "npm run build:android && node scripts/android-gradle.mjs assembleDebug",
    "android:bundle": "npm run build:android && node scripts/android-gradle.mjs bundleRelease",
    "android:open": "cap open android",
    "prerelease": "node scripts/check-release.mjs",
    "release": "npm run build && node scripts/prepare-vc-runtime.mjs && node scripts/build-extensions.mjs && electron-builder --config electron-builder.installer.cjs --win nsis --x64 --publish always",
    "postrelease": "node scripts/check-extension-downloads.mjs",
    "test:desktop": "node scripts/desktop-check.mjs",
    "test:update": "node scripts/update-check.mjs",
    "test:cloud": "node scripts/cloud-sync-check.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.31.0",
    "@supabase/supabase-js": "^2.117.3",
    "electron-updater": "6.8.9",
    "fflate": "^0.8.2",
    "icojs": "1.0.1",
    "koffi": "3.3.2",
    "pdf-lib": "1.17.1",
    "sharp": "0.35.5",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@capacitor/android": "8.5.3",
    "@capacitor/app": "8.1.2",
    "@capacitor/browser": "8.0.5",
    "@capacitor/cli": "8.5.3",
    "@capacitor/core": "8.5.3",
    "@capacitor/filesystem": "8.1.4",
    "@capacitor/share": "8.0.3",
    "@electric-sql/pglite": "0.5.8",
    "@fontsource-variable/inter": "5.3.0",
    "@noble/hashes": "2.4.0",
    "@sqlite.org/sqlite-wasm": "3.53.4-build2",
    "@types/rbush": "^4.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "buffer": "6.0.3",
    "docx-preview": "0.4.1",
    "dompurify": "3.4.16",
    "electron": "44.5.1",
    "electron-builder": "^26.0.12",
    "lucide-react": "^0.468.0",
    "onnxruntime-node": "1.30.0",
    "pdfjs-dist": "6.4.299",
    "pixi.js": "8.21.0",
    "prebuilt-tdlib": "0.1008067.0",
    "prettier": "^3.9.9",
    "qrcode-generator": "2.0.4",
    "rbush": "^4.0.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "supabase": "^2.120.0",
    "typescript": "^5.9.3",
    "vite": "8.3.1"
  },
  "build": {
    "appId": "terra.board.desktop",
    "protocols": [
      {
        "name": "Terra Board",
        "schemes": [
          "terraboard"
        ]
      }
    ],
    "productName": "Terra Board",
    "directories": {
      "output": "release"
    },
    "electronLanguages": [
      "en-US"
    ],
    "files": [
      "dist/**",
      "electron/**",
      "assets/**",
      "package.json",
      "!assets/models/**",
      "!node_modules/pdf-lib/{dist,es,src}/**",
      "!node_modules/zod/src/**",
      "!node_modules/@modelcontextprotocol/sdk/dist/esm/**",
      "!node_modules/**/*.map",
      "!node_modules/koffi/{lib,vendor,doc}/**",
      "!node_modules/koffi/src/koffi/src/abi/**",
      "!node_modules/koffi/src/koffi/src/*.{cc,hh,inc,def}",
      "!node_modules/koffi/src/koffi/CMakeLists.txt"
    ],
    "asarUnpack": [
      "node_modules/sharp/**",
      "node_modules/@img/**",
      "node_modules/@koromix/**"
    ],
    "win": {
      "target": "dir",
      "icon": "assets/icon.ico"
    }
  }
}
