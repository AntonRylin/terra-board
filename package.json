{
  "name": "terra-board",
  "productName": "Terra Board",
  "version": "0.1.24",
  "description": "A private, local visual workspace",
  "author": "Terra Board",
  "license": "UNLICENSED",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "node scripts/prepare-background-model.mjs && node scripts/dev.mjs",
    "preview": "vite --host 127.0.0.1",
    "build": "node scripts/prepare-background-model.mjs && tsc --noEmit && vite build",
    "start": "electron .",
    "test": "node scripts/prepare-background-model.mjs && node --test tests/*.test.mjs",
    "prepackage": "node scripts/check-package-idle.mjs",
    "package": "npm run build && electron-builder --win dir",
    "test:desktop": "node scripts/desktop-check.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.31.0",
    "fflate": "^0.8.2",
    "icojs": "1.0.1",
    "lucide-react": "^0.468.0",
    "onnxruntime-node": "1.30.0",
    "pixi.js": "8.21.0",
    "rbush": "^4.0.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sharp": "0.35.5",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/rbush": "^4.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "electron": "44.5.1",
    "electron-builder": "^26.0.12",
    "prettier": "^3.9.9",
    "typescript": "^5.9.3",
    "vite": "8.3.1"
  },
  "build": {
    "appId": "terra.board.desktop",
    "productName": "Terra Board",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "electron/**",
      "assets/**",
      "package.json",
      "!node_modules/onnxruntime-node/bin/napi-v6/darwin/**",
      "!node_modules/onnxruntime-node/bin/napi-v6/linux/**"
    ],
    "asarUnpack": [
      "node_modules/sharp/**",
      "node_modules/@img/**",
      "node_modules/onnxruntime-node/**",
      "assets/models/*.onnx"
    ],
    "win": {
      "target": "dir",
      "icon": "assets/icon.ico"
    }
  }
}
